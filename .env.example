# --- Worker screenshot (iso-capture). Dibuat otomatis oleh: python scripts/setup_iso_capture.py
ISO_CAPTURE_DB=sales
ISO_CAPTURE_LOGIN=
ISO_CAPTURE_PASSWORD=

# --- Deteksi otomatis: rules (default, tanpa API) atau rag (embedding + pgvector + LLM)
ISO_DETECTION_PROVIDER=rules
# Isi 1 agar judul + kutipan pendek record boleh dikirim ke API embedding/LLM di bawah
ISO_RAG_ENABLED=0
ANTHROPIC_API_KEY=
ISO_AI_MODEL=claude-haiku-5-5
ISO_EMBED_PROVIDER=voyage        # voyage | openai
VOYAGE_API_KEY=
OPENAI_API_KEY=
ISO_EMBED_MODEL=voyage-3.5
ISO_EMBED_DIM=1024
ISO_RAG_TOP_K=8
